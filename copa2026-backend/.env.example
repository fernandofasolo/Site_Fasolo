# Copie para .env e ajuste conforme necessário
# Em dev local não é obrigatório — os defaults já funcionam

# Caminho do banco SQLite (relativo ao backend/ ou absoluto)
# DB_PATH=db/copa2026.db

# Porta da API (padrão: 8000)
# PORT=8000

# Chave de acesso ao painel /admin no frontend
ADMIN_KEY=troca_aqui

# URL do frontend (para CORS em produção)
# FRONTEND_URL=https://fasolo.ia.br
