---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const countFernando = posts.filter(p => p.data.author === 'Fernando Fasolo').length;
const countFasolinho = posts.filter(p => p.data.author === 'Fernando Fasolo Jr.').length;

const latestFernando = posts
  .filter(p => p.data.author === 'Fernando Fasolo')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const latestFasolinho = posts
  .filter(p => p.data.author === 'Fernando Fasolo Jr.')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .author-card {
        background: rgba(15,15,25,.7);
        border: 1px solid rgba(255,255,255,.07);
        backdrop-filter: blur(12px);
        transition: border-color .3s, transform .3s;
      }
      .author-card:hover { transform: translateY(-6px); }
      .author-card-pai:hover  { border-color: rgba(217,119,6,.5); }
      .author-card-filho:hover { border-color: rgba(74,222,128,.4); }
    </style>
  </head>
  <body>
    <Header />

    <main class="pt-28 pb-20">
      <div class="max-w-4xl mx-auto px-6">

        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-black text-white mb-4" style="font-family:'Orbitron',monospace;">Blog</h1>
          <p class="text-slate-400 max-w-xl mx-auto">Dois autores, duas perspectivas. Escolha quem você quer ler.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">

          <!-- Card Fernando Fasolo Pai -->
          <a href="/blog/fernando-fasolo" class="author-card author-card-pai rounded-2xl p-8 block group">
            <div class="mb-6">
              <div class="w-16 h-16 rounded-full bg-amber-900/40 border-2 border-amber-500/40 flex items-center justify-center mb-4 text-2xl font-black text-amber-400" style="font-family:'Orbitron',monospace;">FF</div>
              <h2 class="text-2xl font-black text-white group-hover:text-amber-400 transition-colors" style="font-family:'Orbitron',monospace;">
                Fernando Fasolo
              </h2>
              <p class="text-amber-500/70 text-sm font-medium mt-1">Velho Pai</p>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Empreendedor de telecom, entusiasta de IA e vibe coder nas horas vagas. Escreve sobre tecnologia, negócios e o dia a dia de quem constrói coisas sem ter estudado para isso.
            </p>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>{countFernando} {countFernando === 1 ? 'post' : 'posts'}</span>
              {latestFernando && (
                <span>Último: {latestFernando.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'short' })}</span>
              )}
            </div>
            <div class="mt-6 text-amber-400 text-sm font-semibold group-hover:translate-x-1 transition-transform inline-block">
              Ver posts →
            </div>
          </a>

          <!-- Card Fasolinho -->
          <a href="/blog/fasolinho" class="author-card author-card-filho rounded-2xl p-8 block group">
            <div class="mb-6">
              <div class="w-16 h-16 rounded-full bg-green-900/40 border-2 border-green-500/40 flex items-center justify-center mb-4 text-2xl font-black text-green-400" style="font-family:'Orbitron',monospace;">FFF</div>
              <h2 class="text-2xl font-black text-white group-hover:text-green-400 transition-colors" style="font-family:'Orbitron',monospace;">
                Fernando Fasolo Jr.
              </h2>
              <p class="text-green-500/70 text-sm font-medium mt-1">Fasolinho Bebezão</p>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              Filho do Fasolo, torcedor do Figueirense e fã da Copa do Mundo 2026. Escreve sobre esportes, games e o que passa pela cabeça de quem está crescendo junto com a internet.
            </p>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span>{countFasolinho} {countFasolinho === 1 ? 'post' : 'posts'}</span>
              {latestFasolinho && (
                <span>Último: {latestFasolinho.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'short' })}</span>
              )}
            </div>
            <div class="mt-6 text-green-400 text-sm font-semibold group-hover:translate-x-1 transition-transform inline-block">
              Ver posts →
            </div>
          </a>

        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>
