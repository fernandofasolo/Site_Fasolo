---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getImage, Image } from 'astro:assets';
import capaDesktop from '../assets/capa/capa-desktop.jpg';
import capaMobile from '../assets/capa/capa-mobile.jpg';
import logoVidro from '../assets/logo/fasolo-glass.png';
import CardImagem from '../components/CardImagem.astro';
import imgPai from '../assets/cards/card-pai.jpg';
import imgFilho from '../assets/cards/card-filho.jpg';
import imgVoxel from '../assets/cards/card-voxel.jpg';
import imgObby from '../assets/cards/card-obby.jpg';
import imgEstadio from '../assets/cards/card-estadio.jpg';
import imgGameplay from '../assets/cards/card-gameplay.jpg';
import imgCotidiano from '../assets/cards/card-cotidiano.jpg';
import imgTecnologia from '../assets/cards/card-tecnologia.jpg';
import imgNegocios from '../assets/cards/card-negocios.jpg';
import imgTechPosts from '../assets/cards/card-tech-posts.jpg';

// Capa do hero (gerada com Nano Banana Pro): versão horizontal no desktop e
// vertical no celular, em WebP com srcset por largura. AVIF ficou de fora de
// propósito: nesta imagem ele saía quase o dobro do WebP.
async function variantes(src: ImageMetadata, larguras: number[]) {
  const itens = await Promise.all(
    larguras.map(async (w) => `${(await getImage({ src, width: w, format: 'webp', quality: 72 })).src} ${w}w`),
  );
  return itens.join(', ');
}
const capaD = await variantes(capaDesktop, [1280, 1920, 2560]);
const capaM = await variantes(capaMobile, [640, 828, 1080]);
const capaFallback = await getImage({ src: capaDesktop, width: 1920, format: 'jpg', quality: 78 });

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Ilustrações dos cards (Nano Banana Pro, mesmo estilo da capa). Post sem
// heroImage usa a ilustração da sua categoria.
const imagemDaCategoria: Record<string, ImageMetadata> = {
  Tech: imgTechPosts, Negócios: imgNegocios, Games: imgGameplay, Esportes: imgEstadio, Cotidiano: imgCotidiano,
};
// Ordem: imagem própria do card > heroImage > ilustração da categoria (Games do
// Fasolinho usa o cantinho gamer dele, para os posts em dupla não repetirem).
function imagemDoPost(d: { cardImage?: ImageMetadata; heroImage?: ImageMetadata; category: string; author: string }) {
  if (d.cardImage) return d.cardImage;
  if (d.heroImage) return d.heroImage;
  if (d.category === 'Games' && d.author === 'Fernando Fasolo Jr.') return imgFilho;
  return imagemDaCategoria[d.category] ?? imgTechPosts;
}

const categoryColor: Record<string, string> = {
  Tech:      'bg-amber-900/40 text-amber-300',
  Negócios:  'bg-amber-900/40 text-amber-300',
  Games:     'bg-green-900/40 text-green-300',
  Esportes:  'bg-green-900/40 text-green-300',
  Cotidiano: 'bg-orange-900/40 text-orange-300',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      // Recarregar (F5 / puxar para baixo) volta ao topo. Sem isto o navegador
      // restaura a rolagem anterior ou pula para a âncora que ficou no endereço
      // (ex.: #pai depois de tocar num botão). Links vindos de outras páginas
      // (/#contato no menu do blog) continuam indo para a seção certa.
      (function () {
        // 'manual' já no primeiro carregamento: se só fosse ligado no reload, o
        // navegador às vezes restaurava a rolagem antiga depois do nosso scrollTo.
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (!nav || nav.type !== 'reload') return;
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        // 'instant': o global.css liga scroll-behavior: smooth, e uma rolagem
        // suave aqui seria interrompida enquanto a página termina de carregar.
        var topo = function () { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); };
        topo();
        addEventListener('DOMContentLoaded', topo);
        addEventListener('load', function () { topo(); requestAnimationFrame(topo); });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "Fasolo",
          "url": "https://fasolo.ia.br",
          "description": "Fernando Fasolo e Fernando Fasolo Filho — conteúdo sobre tech, negócios e games.",
          "inLanguage": "pt-BR"
        },
        {
          "@type": "Person",
          "name": "Fernando Fasolo",
          "url": "https://fasolo.ia.br",
          "sameAs": [
            "https://www.linkedin.com/in/fernando-fasolo-96b30114/",
            "https://www.instagram.com/fernandofasollo/"
          ],
          "jobTitle": "Empreendedor",
          "knowsAbout": ["Telecomunicações", "Tecnologia", "Negócios", "Inteligência Artificial", "SaaS"]
        },
        {
          "@type": "Person",
          "name": "Fernando Fasolo Jr.",
          "url": "https://fasolo.ia.br/#filho",
          "knowsAbout": ["Roblox", "Minecraft", "Games", "Copa do Mundo 2026"]
        }
      ]
    })} />
    <style>
      @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
      .float { animation: float 4s ease-in-out infinite; }
      @keyframes pulse-border {
        0%,100%{border-color:rgba(251,122,69,.3)}
        50%{border-color:rgba(251,122,69,.8)}
      }
      .pulse-border { animation: pulse-border 3s ease-in-out infinite; }
      .card-glass {
        background: rgba(15,15,25,.7);
        border: 1px solid rgba(255,255,255,.07);
        backdrop-filter: blur(12px);
        transition: border-color .3s, transform .3s;
      }
      .card-glass:hover { border-color: rgba(251,122,69,.5); transform: translateY(-4px); }
      .card-game:hover  { border-color: rgba(31,199,182,.5) !important; }
      .hero-bg {
        background: radial-gradient(ellipse at 20% 50%, rgba(251,122,69,.15) 0%,transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(31,199,182,.10) 0%,transparent 50%),
                    #100c0d;
      }
      /* Selo do hero: se a fonte do sistema for grande e ele quebrar em duas
         linhas, cantos de pílula (9999px) cortariam o texto; aqui o raio é
         moderado e há folga lateral. */
      .tag-selo { border-radius: 12px; padding: 4px 14px; line-height: 1.5; max-width: 100%; text-wrap: balance; }
      /* No celular o selo encolhe para caber numa linha só dentro do chip. */
      @media (max-width: 639px) { .tag-selo { font-size: .6rem; letter-spacing: .04em; padding: 3px 10px; } }
      /* Palavra longa em título (ex.: "Publicações") com fonte do sistema grande
         num celular estreito: quebra com hífen em vez de estourar a tela. */
      section h2, section h3, section h4 { overflow-wrap: break-word; hyphens: auto; }
      .hero-veu {
        background:
          radial-gradient(ellipse 60% 55% at 50% 50%, rgba(16,12,13,.72) 0%, rgba(16,12,13,.35) 60%, transparent 100%),
          linear-gradient(to bottom, rgba(16,12,13,.55) 0%, transparent 18%, transparent 70%, #100c0d 100%);
      }
      .tag {
        display:inline-block; padding:2px 10px; border-radius:9999px;
        font-size:.7rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
      }
      .glow-amber  { text-shadow: 0 0 20px rgba(251,122,69,.8); }
      .glow-green  { text-shadow: 0 0 20px rgba(31,199,182,.8); }
    </style>
  </head>
  <body>
    <Header />

    <!-- HERO -->
    <section class="hero-bg relative isolate overflow-hidden min-h-screen flex items-center pt-20">
      <picture aria-hidden="true">
        <source media="(max-width: 767px)" type="image/webp" srcset={capaM} sizes="100vw" />
        <source type="image/webp" srcset={capaD} sizes="100vw" />
        <img
          src={capaFallback.src}
          alt=""
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <!-- escurece o centro para o título e funde a borda de baixo com a próxima seção -->
      <div class="hero-veu absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-24 text-center">
        <div class="inline-block mb-4 sm:mb-6">
          <span class="tag tag-selo bg-amber-900/60 text-amber-300 border border-amber-700/50">Tech · Negócios · Games</span>
        </div>
        <!-- Logo em vidro (estilo Liquid Glass do iOS, Nano Banana Pro). O fundo
             preto da arte virou transparência, então o vidro deixa ver a capa.
             O alt mantém "[FASOLO]" como texto do h1 para buscadores e leitores de tela. -->
        <h1 class="mb-3 sm:mb-5 leading-none">
          <Image
            src={logoVidro}
            alt="[FASOLO]"
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 768px) 34rem, (min-width: 640px) 26rem, 72vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            class="mx-auto block h-auto w-[72vw] max-w-[17rem] sm:w-[26rem] sm:max-w-none md:w-[34rem]"
          />
        </h1>
        <p class="text-slate-300 text-base sm:text-lg md:text-2xl mb-3 sm:mb-4 max-w-2xl mx-auto">
          Cotidiano, área tech, negócios e jogatinas
        </p>
        <p class="text-slate-500 text-sm sm:text-base mb-8 sm:mb-10">
          por <span class="text-amber-400 font-semibold whitespace-nowrap">Fernando Fasolo</span> &amp;{' '}
          <span class="text-green-400 font-semibold whitespace-nowrap">Fernando Fasolo Filho</span>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
          <a href="#pai" class="w-full max-w-64 sm:w-auto sm:max-w-none text-center text-sm sm:text-base px-6 sm:px-8 py-3 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-semibold transition-colors">
            Tech & Negócios
          </a>
          <a href="#filho" class="w-full max-w-64 sm:w-auto sm:max-w-none text-center text-sm sm:text-base px-6 sm:px-8 py-3 rounded-lg bg-green-700 hover:bg-green-600 text-white font-semibold transition-colors">
            Games & Esportes
          </a>
        </div>
        <div class="mt-20 flex flex-wrap justify-center gap-4 text-xs text-slate-500">
          <span class="float card-glass whitespace-nowrap px-4 py-2 rounded-full" style="animation-delay:0s">⛏️ Minecraft</span>
          <span class="float card-glass whitespace-nowrap px-4 py-2 rounded-full flex items-center gap-1.5" style="animation-delay:.5s"><img src="https://upload.wikimedia.org/wikipedia/commons/f/f2/Roblox_%282025%29_%28App_Icon%29.svg" class="w-4 h-4 rounded-sm" alt="Roblox" /> Roblox</span>
          <span class="float card-glass whitespace-nowrap px-4 py-2 rounded-full" style="animation-delay:1s">💻 Tech</span>
          <span class="float card-glass whitespace-nowrap px-4 py-2 rounded-full" style="animation-delay:1.5s">📈 Negócios</span>
          <a href="/copa2026/" class="float card-glass whitespace-nowrap px-4 py-2 rounded-full" style="animation-delay:2s">⚽ Copa 2026</a>
          {/* Guia interno (eSIM BRsip). Pede PIN na propria pagina; fora do menu,
              do sitemap e dos buscadores. */}
          <a href="/esim-discord/" class="float card-glass whitespace-nowrap px-4 py-2 rounded-full flex items-center gap-1.5" style="animation-delay:2.5s" rel="nofollow">🔒 Discord</a>
        </div>
      </div>
    </section>

    <!-- SOBRE -->
    <section id="sobre" class="py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-3" style="font-family:'Sora', sans-serif;">Quem Somos</h2>
          <p class="text-slate-400 max-w-xl mx-auto">Pai e filho compartilhando o que amam — cada um do seu jeito.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div id="pai" class="card-glass group overflow-hidden rounded-2xl p-8 pulse-border">
            <CardImagem src={imgPai} sangria="-mx-8 -mt-8" />
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 rounded-full bg-amber-900/60 border-2 border-amber-500 flex items-center justify-center text-2xl">
                <span class="text-amber-400">💼</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white" style="font-family:'Sora', sans-serif;">Fernando Fasolo</h3>
                <span class="text-amber-400 text-sm">Tech · Negócios · Cotidiano</span>
              </div>
            </div>
            <p class="text-slate-400 leading-relaxed mb-6">
              Empreendedor da área de telecomunicações e tecnologia. Aqui compartilho experiências do mundo dos negócios, novidades em tech e reflexões do dia a dia.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="tag bg-amber-900/40 text-amber-300">Telecom</span>
              <span class="tag bg-amber-900/40 text-amber-300">SaaS</span>
              <span class="tag bg-amber-900/40 text-amber-300">Empreendedorismo</span>
              <span class="tag bg-amber-900/40 text-amber-300">IA</span>
            </div>
          </div>
          <div id="filho" class="card-glass card-game group overflow-hidden rounded-2xl p-8">
            <CardImagem src={imgFilho} sangria="-mx-8 -mt-8" />
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 rounded-full bg-green-900/60 border-2 border-green-500 flex items-center justify-center text-2xl">
                <span class="text-green-400">🎮</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white" style="font-family:'Sora', sans-serif;">Fernando Fasolo <span class="text-green-400">Jr.</span></h3>
                <span class="text-green-400 text-sm">Gamer · Roblox · Minecraft</span>
              </div>
            </div>
            <p class="text-slate-400 leading-relaxed mb-6">
              Gamer nato, especialista em Roblox e Minecraft. Adora descobrir novos jogos na plataforma. Fora das telas, é torcedor do <span class="text-green-400 font-semibold">Figueirense</span> e acompanha tudo da <a href="/copa2026/" class="text-green-400 hover:underline">Copa do Mundo 2026</a>.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="tag bg-green-900/40 text-green-300">Roblox</span>
              <span class="tag bg-green-900/40 text-green-300">Minecraft</span>
              <span class="tag bg-green-900/40 text-green-300">Gameplay</span>
              <a href="/copa2026/" class="tag bg-green-800/60 text-green-300 border border-green-600/50">⚽ Copa 2026</a>
              <a href="/fasolinho/" class="tag bg-green-900/40 text-green-300 hover:bg-green-800/60 transition-colors">Futebol</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ÚLTIMOS POSTS -->
    {posts.length > 0 && (
      <section class="py-20 bg-slate-950/50">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-14">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-3" style="font-family:'Sora', sans-serif;">Últimas Publicações</h2>
            <p class="text-slate-400">O que saiu recentemente no blog</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {posts.map(post => (
              <a href={`/blog/${post.id}/`} class="card-glass rounded-2xl p-6 block group overflow-hidden">
                <CardImagem src={imagemDoPost(post.data)} sangria="-mx-6 -mt-6" />
                <div class="flex items-center gap-2 mb-3">
                  <span class={`tag ${categoryColor[post.data.category] ?? 'bg-slate-800 text-slate-300'}`}>
                    {post.data.category}
                  </span>
                  <span class="text-xs text-slate-600">
                    {post.data.pubDate.toLocaleDateString('pt-BR', { day:'2-digit', month:'short', year:'numeric', timeZone:'UTC' })}
                  </span>
                </div>
                <h3 class="text-white font-bold text-lg mb-2 group-hover:text-amber-400 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">{post.data.description}</p>
                <p class="text-xs text-slate-600 mt-4">por {post.data.author}</p>
              </a>
            ))}
          </div>
          <div class="text-center mt-10">
            <a href="/blog/" class="px-8 py-3 rounded-lg border border-amber-700/50 text-amber-400 hover:bg-amber-900/30 transition-colors font-semibold">
              Ver todos os posts →
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- GAMES -->
    <section id="games" class="py-20">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <span class="tag bg-green-900/60 text-green-300 border border-green-700/50 mb-4 inline-block">Zona Gamer</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 glow-green" style="font-family:'Sora', sans-serif;">Games em Destaque</h2>
          <p class="text-slate-400">O que o Fasolinho tá jogando agora</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="card-glass card-game group overflow-hidden rounded-2xl p-6 text-center">
            <CardImagem src={imgVoxel} sangria="-mx-6 -mt-6" selo="⛏️" />
            <h4 class="text-lg font-bold text-white mb-2" style="font-family:'Sora', sans-serif;">Minecraft</h4>
            <p class="text-slate-400 text-sm mb-4">Construção, survival e criatividade sem limites. Um clássico que nunca sai de moda.</p>
            <span class="tag bg-green-900/40 text-green-300">Ativo</span>
          </div>
          <div class="card-glass card-game group overflow-hidden rounded-2xl p-6 text-center">
            <CardImagem src={imgObby} sangria="-mx-6 -mt-6" selo="🧱" />
            <h4 class="text-lg font-bold text-white mb-2" style="font-family:'Sora', sans-serif;">Roblox</h4>
            <p class="text-slate-400 text-sm mb-4">Plataforma com centenas de jogos. Cada semana tem um novo hit pra descobrir e dominar.</p>
            <span class="tag bg-red-900/40 text-red-300">Plataforma Principal</span>
          </div>
          <a href="/copa2026/" class="card-glass card-game group overflow-hidden rounded-2xl p-6 text-center block hover:border-green-500/50 transition-colors">
            <CardImagem src={imgEstadio} sangria="-mx-6 -mt-6" selo="⚽" />
            <h4 class="text-lg font-bold text-white mb-2" style="font-family:'Sora', sans-serif;">Copa 2026</h4>
            <p class="text-slate-400 text-sm mb-4">Tabela, grupos, escalação do Brasil e bolão. Tudo sobre a Copa do Mundo FIFA 2026.</p>
            <span class="tag bg-green-900/40 text-green-300">Acompanhe →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- TÓPICOS -->
    <section class="py-20 bg-slate-950/50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-3" style="font-family:'Sora', sans-serif;">O Que Você Vai Encontrar</h2>
          <p class="text-slate-400">Conteúdo dos dois mundos</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { icon:'💻', img: imgTecnologia, title:'Tecnologia', desc:'Homelab, infraestrutura e IA aplicada — do Proxmox ao Claude, passando por Docker, VoIP e VPN.', color:'amber', href:'/tecnologia/', tags:[
              {label:'🤖 IA',             cls:'bg-amber-900/40 text-amber-300'},
              {label:'🐳 Docker',         cls:'bg-blue-900/40 text-blue-300'},
              {label:'🐧 Linux',          cls:'bg-yellow-900/40 text-yellow-300'},
              {label:'🖥️ Proxmox',        cls:'bg-orange-900/40 text-orange-300'},
              {label:'📞 VoIP · Issabel', cls:'bg-teal-900/40 text-teal-300'},
              {label:'🔒 VPN',            cls:'bg-violet-900/40 text-violet-300'},
            ]},
            { icon:'📈', img: imgNegocios, title:'Negócios',   desc:'Empreendedorismo, estratégia, experiências reais do dia a dia empresarial.', color:'amber', href:'', tags:[] },
            { icon:'🎮', img: imgGameplay, title:'Gameplay',   desc:'Dicas, descobertas e momentos épicos no Roblox e Minecraft. E futebol também — o Fasolinho é florianopolitano raiz, nasceu e cresceu na Grande Floripa torcendo pro Figueirense.', color:'green', href:'', tags:[] },
            { icon:'☀️', img: imgCotidiano, title:'Cotidiano',  desc:'A vida real de pai e filho curiosos, sempre aprendendo algo novo.', color:'orange', href:'', tags:[] },
          ].map(item => {
            const inner = <>
              <CardImagem src={item.img} sangria="-mx-6 -mt-6" proporcao="aspect-[16/10]" selo={item.icon} />
              <h4 class="font-semibold text-white mb-2">{item.title}</h4>
              <p class="text-slate-400 text-sm">{item.desc}</p>
              {item.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-3">
                  {item.tags.map(t => <span class={`tag ${t.cls}`}>{t.label}</span>)}
                </div>
              )}
              {item.href && <p class="text-xs text-amber-500 mt-4 font-semibold">Ver mais →</p>}
            </>;
            return item.href
              ? <a href={item.href} class="card-glass group overflow-hidden rounded-xl p-6 block">{inner}</a>
              : <div class="card-glass group overflow-hidden rounded-xl p-6">{inner}</div>;
          })}
        </div>
      </div>
    </section>

    <!-- CONTATO -->
    <section id="contato" class="py-20">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family:'Sora', sans-serif;">Fale com a Gente</h2>
        <p class="text-slate-400 mb-10">Dúvidas, parcerias ou só um oi — estamos aqui.</p>
        <div class="card-glass rounded-2xl p-8">
          <div class="flex flex-col gap-4">
            <a href="mailto:fernandofasolo@gmail.com"
               class="flex items-center gap-3 px-6 py-4 rounded-xl bg-amber-900/30 hover:bg-amber-900/50 border border-amber-800/50 hover:border-amber-500 transition-all text-left">
              <span class="text-amber-400 text-xl">✉</span>
              {/* min-w-0 + break-words: o e-mail e uma palavra so, e sem isso o
                  flex child se recusa a encolher abaixo dela e estoura a tela
                  estreita (320px). */}
              <div class="min-w-0">
                <div class="text-xs text-slate-500 uppercase tracking-widest">Fernando Fasolo</div>
                <div class="text-white font-medium text-sm sm:text-base break-words">fernandofasolo@gmail.com</div>
              </div>
            </a>
            <a href="mailto:fernandofasolofilho@gmail.com"
               class="flex items-center gap-3 px-6 py-4 rounded-xl bg-green-900/30 hover:bg-green-900/50 border border-green-800/50 hover:border-green-500 transition-all text-left">
              <span class="text-green-400 text-xl">✉</span>
              <div class="min-w-0">
                <div class="text-xs text-slate-500 uppercase tracking-widest">Fernando Fasolo Jr.</div>
                <div class="text-white font-medium text-sm sm:text-base break-words">fernandofasolofilho@gmail.com</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />

    <!-- VISITOR WIDGET -->
    <div id="visitor-widget" class="hidden fixed bottom-4 right-4 z-50">
      <!-- Depois de 3 s o card recolhe para esta pílula; tocar nela reabre o card. -->
      <button id="visitor-pill" type="button" class="hidden card-glass rounded-full px-4 py-2 text-sm font-semibold text-amber-300 shadow-xl shadow-black/40 hover:text-amber-200" aria-expanded="false" aria-controls="visitor-card">
        👋 Bem-vindo!
      </button>
      <div id="visitor-card" class="card-glass rounded-xl p-4 w-56 shadow-xl shadow-black/40">
        <div class="flex items-center justify-between mb-3">
          <span class="text-amber-400 font-semibold text-xs uppercase tracking-widest">👁 Sua visita</span>
          <button id="visitor-close" type="button" aria-label="Recolher" class="text-slate-600 hover:text-slate-300 text-lg leading-none transition-colors">×</button>
        </div>
        <div id="visitor-loading" class="text-xs text-slate-600 text-center py-1">carregando...</div>
        <div id="visitor-info" class="hidden space-y-2 text-xs"></div>
        <p class="text-slate-700 text-xs mt-3 border-t border-slate-800 pt-2">
          Localização via <a id="visitor-fonte" href="https://ipinfo.io" target="_blank" rel="noopener" class="underline hover:text-slate-500">ipinfo.io</a>. Nenhum dado é armazenado.
        </p>
      </div>
    </div>

    <script>
      (async () => {
        const widget   = document.getElementById('visitor-widget')!;
        const loading  = document.getElementById('visitor-loading')!;
        const info     = document.getElementById('visitor-info')!;
        const closeBtn = document.getElementById('visitor-close')!;
        const card     = document.getElementById('visitor-card')!;
        const pill     = document.getElementById('visitor-pill')!;

        const ua = navigator.userAgent;
        let browser = 'Desconhecido', os = 'Desconhecido';

        if      (ua.includes('Firefox/'))                          browser = 'Firefox';
        else if (ua.includes('Edg/'))                              browser = 'Edge';
        else if (ua.includes('OPR/') || ua.includes('Opera'))      browser = 'Opera';
        else if (ua.includes('Chrome/'))                           browser = 'Chrome';
        else if (ua.includes('Safari/') && !ua.includes('Chrome')) browser = 'Safari';

        if      (ua.includes('Android'))                           os = 'Android';
        else if (ua.includes('iPhone') || ua.includes('iPad'))     os = 'iOS';
        else if (ua.includes('Windows NT'))                        os = 'Windows';
        else if (ua.includes('Mac OS X'))                          os = 'macOS';
        else if (ua.includes('Linux'))                             os = 'Linux';

        // O card aparece por 3 s e recolhe para a pílula "Bem-vindo!".
        function recolher() {
          card.classList.add('hidden');
          pill.classList.remove('hidden');
          pill.setAttribute('aria-expanded', 'false');
        }
        function expandir() {
          pill.classList.add('hidden');
          card.classList.remove('hidden');
          pill.setAttribute('aria-expanded', 'true');
        }
        // Os 3 s contam a partir de quando o card está na tela E com os dados
        // (ou com o aviso de indisponível), para dar tempo de ler.
        let naTela = false, pronto = false;
        function agendarRecolher() {
          if (naTela && pronto) setTimeout(recolher, 3000);
        }
        function mostrar() {
          widget.classList.remove('hidden');
          naTela = true;
          agendarRecolher();
        }
        closeBtn.addEventListener('click', recolher);
        pill.addEventListener('click', expandir);
        // No celular o card ficaria por cima dos botões da capa: só aparece
        // depois que a pessoa rola para além dela.
        if (matchMedia('(max-width: 767px)').matches) {
          const hero = document.querySelector('section.hero-bg')!;
          new IntersectionObserver(([e], obs) => {
            if (!e.isIntersecting) { mostrar(); obs.disconnect(); }
          }).observe(hero);
        } else {
          mostrar();
        }

        function weatherLabel(code: number): [string, string] {
          if (code === 0)  return ['☀️', 'Céu limpo'];
          if (code <= 3)   return ['⛅', 'Nublado'];
          if (code <= 48)  return ['🌫️', 'Neblina'];
          if (code <= 55)  return ['🌦️', 'Garoa'];
          if (code <= 65)  return ['🌧️', 'Chuva'];
          if (code <= 75)  return ['❄️', 'Neve'];
          if (code <= 82)  return ['🌦️', 'Pancadas'];
          if (code <= 99)  return ['⛈️', 'Trovoada'];
          return ['🌡️', '—'];
        }

        // Os valores vêm de serviços de terceiros: escapados antes do innerHTML.
        const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
        function row(label: string, value: string) {
          return `<div class="flex justify-between gap-2">
            <span class="text-slate-500">${label}</span>
            <span class="text-slate-300 font-medium truncate max-w-28 text-right">${esc(value)}</span>
          </div>`;
        }
        const divider = `<div class="border-t border-slate-700/50 my-1"></div>`;

        // JSON com limite de tempo: um serviço pendurado não deixa o card
        // preso em "carregando..." nem segura o recolhimento.
        async function json(url: string) {
          const res = await fetch(url, { signal: AbortSignal.timeout(5000) });
          if (!res.ok) throw new Error(`${url} respondeu ${res.status}`);
          return res.json();
        }

        type Local = { ip?: string; city?: string; region?: string; country?: string; lat?: string; lon?: string };
        // O ipinfo sem token tem cota diária por IP e, ao estourar, responde
        // 429 sem CORS. Os reservas não pedem chave e liberam CORS.
        const provedores: [string, string, (d: any) => Local][] = [
          ['ipinfo.io', 'https://ipinfo.io/json', (d) => {
            const [lat, lon] = d.loc ? d.loc.split(',') : [];
            return { ip: d.ip, city: d.city, region: d.region, country: d.country, lat, lon };
          }],
          ['geojs.io', 'https://get.geojs.io/v1/ip/geo.json', (d) => ({
            ip: d.ip, city: d.city, region: d.region, country: d.country_code, lat: d.latitude, lon: d.longitude,
          })],
          ['ipwho.is', 'https://ipwho.is/', (d) => {
            if (d.success === false) throw new Error('ipwho.is recusou');
            return { ip: d.ip, city: d.city, region: d.region, country: d.country_code, lat: d.latitude, lon: d.longitude };
          }],
        ];

        async function localizar(): Promise<[string, Local]> {
          for (const [nome, url, ler] of provedores) {
            try { return [nome, ler(await json(url))]; } catch {}
          }
          throw new Error('nenhum provedor de localização respondeu');
        }

        try {
          const [fonte, ip] = await localizar();
          const credito = document.getElementById('visitor-fonte') as HTMLAnchorElement;
          credito.textContent = fonte;
          credito.href = `https://${fonte}`;

          let html = [
            row('🌐 IP',      ip.ip              ?? '—'),
            row('📍 Local',   `${ip.city ?? '?'}, ${ip.country ?? '?'}`),
            row('🗺️ Região',  ip.region          ?? '—'),
            row('🖥️ Browser', browser),
            row('💻 Sistema', os),
          ].join('');

          // Sem clima o card continua útil: a falha aqui não apaga a localização.
          if (ip.lat && ip.lon) {
            try {
              const wData = await json(
                `https://api.open-meteo.com/v1/forecast?latitude=${ip.lat}&longitude=${ip.lon}` +
                `&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&timezone=auto`
              );
              const cur   = wData.current;
              const [icon, label] = weatherLabel(cur.weather_code);

              html += divider + [
                row(`${icon} Tempo`,   label),
                row('🌡️ Temp',        `${cur.temperature_2m}°C`),
                row('💧 Umidade',     `${cur.relative_humidity_2m}%`),
                row('💨 Vento',       `${cur.wind_speed_10m} km/h`),
              ].join('');
            } catch {}
          }

          loading.classList.add('hidden');
          info.classList.remove('hidden');
          info.innerHTML = html;
        } catch {
          loading.textContent = 'indisponível';
        }
        pronto = true;
        agendarRecolher();
      })();
    </script>
  </body>
</html>
