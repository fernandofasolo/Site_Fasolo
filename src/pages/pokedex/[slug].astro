---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Pokedex from '../../components/Pokedex.astro';
import { TREINADORES } from '../../data/pokedex/treinadores';
import { SITE_TITLE } from '../../consts';

export function getStaticPaths() {
  return TREINADORES.map((treinador) => ({
    params: { slug: treinador.slug },
    props: { treinador },
  }));
}

const { treinador } = Astro.props;
const { progresso } = treinador;

const outro = TREINADORES.find((t) => t.slug !== treinador.slug)!;
const pct = progresso.percentual.toFixed(1).replace('.', ',');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Pokédex de ${treinador.apelido === 'o pai' ? 'Fernando Fasolo' : 'Fasolinho'} — ${SITE_TITLE}`}
      description={`A Pokédex Nacional aberta: ${progresso.capturados} de ${progresso.total} registrados (${pct}%). Veja o que já foi capturado e o que ainda falta.`}
    />
  </head>
  <body>
    <Header />

    <main class="pt-28 pb-20">
      <div class="max-w-7xl mx-auto px-6">

        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <a href="/pokedex/" class="text-slate-500 hover:text-white transition-colors">← Pokédex</a>
          <span class="text-slate-700">|</span>
          <a
            href={`/pokedex/${outro.slug}/`}
            class="text-slate-500 hover:text-white transition-colors"
            style={`--h:${outro.cor}`}
          >
            Ver a Pokédex do {outro.apelido === 'o pai' ? 'pai' : 'Fasolinho'} →
          </a>
        </div>

        <header class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-16 h-16 rounded-full flex items-center justify-center text-xl font-black flex-shrink-0"
              style={`font-family:'Sora',sans-serif; color:${treinador.cor}; background:rgb(${treinador.corRgb} / .13); border:2px solid rgb(${treinador.corRgb} / .4);`}
            >
              {treinador.iniciais}
            </div>
            <div>
              <h1 class="text-3xl md:text-4xl font-black text-white leading-tight" style="font-family:'Sora',sans-serif;">
                Pokédex de {treinador.apelido === 'o pai' ? 'Fernando Fasolo' : 'Fasolinho'}
              </h1>
              <p class="text-slate-500 text-sm mt-1">
                Treinador desde {treinador.desde} ·
                <a href={treinador.blog} class="hover:text-white transition-colors underline decoration-slate-700">
                  ler o blog
                </a>
              </p>
            </div>
          </div>
          <p class="text-slate-400 max-w-2xl leading-relaxed">
            A Pokédex Nacional inteira, do <strong class="text-slate-300">#001 Bulbasaur</strong> ao{' '}
            <strong class="text-slate-300">#1025 Pecharunt</strong>. Quem já foi registrado aparece em cor cheia;
            quem ainda falta continua visível, só que com a cor lavada e um "?" no canto.
          </p>
        </header>

        <Pokedex treinador={treinador} />

      </div>
    </main>

    <Footer />
  </body>
</html>
