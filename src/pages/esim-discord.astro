    <script is:inline>
      /* Portao de PIN — CONVENIENCIA, NAO SEGURANCA.
         Isto e um site estatico: o HTML inteiro ja chegou ao navegador antes do
         PIN ser digitado, e qualquer pessoa ve o conteudo pelo "ver codigo-fonte".
         Guardamos o HASH em vez do PIN so para evitar a leitura casual do numero
         no fonte — um PIN de 4 digitos se quebra por forca bruta instantaneamente.
         Por isso o conteudo desta pagina e a versao PUBLICA e reescrita do
         briefing: ela e segura mesmo se vazar. NAO trazer para ca nada do
         `23-briefing-discord-operador.md` (repo privado) contando com este portao.
         Se um dia precisar de protecao de verdade: adapter da Vercel + rota
         serverless com HTTP Basic (mesmo esquema do servidor de artifacts da VM). */
      (function () {
        var SALT = 'fasolo-esim-discord';
        var HASH = '1767aa37ba5c4a868377197ce65aa541698056fa8d3ad5532d307f98145b0b0d';
        var CHAVE = 'fasolo_guia_discord';

        var gate = document.getElementById('gate');
        var form = document.getElementById('gate-form');
        var campo = document.getElementById('pin');
        var msg = document.getElementById('gate-msg');
        var conteudo = document.getElementById('conteudo');

        function abrir() {
          gate.hidden = true;
          conteudo.hidden = false;
        }

        // Ja liberou antes neste navegador? Nao pede de novo.
        try {
          if (localStorage.getItem(CHAVE) === HASH) { abrir(); return; }
        } catch (e) {}

        campo.focus();

        async function sha256(txt) {
          var buf = new TextEncoder().encode(txt);
          var dig = await crypto.subtle.digest('SHA-256', buf);
          return Array.from(new Uint8Array(dig))
            .map(function (b) { return b.toString(16).padStart(2, '0'); })
            .join('');
        }

        form.addEventListener('submit', async function (ev) {
          ev.preventDefault();
          var valor = (campo.value || '').trim();
          if (!valor) return;

          var ok = false;
          try {
            ok = (await sha256(SALT + valor)) === HASH;
          } catch (e) {
            // crypto.subtle exige contexto seguro (https ou localhost)
            msg.textContent = 'Abra a página por https para digitar o PIN.';
            return;
          }

          if (ok) {
            try { localStorage.setItem(CHAVE, HASH); } catch (e) {}
            msg.textContent = '';
            abrir();
          } else {
            gate.classList.remove('erro');
            void gate.offsetWidth;          // reinicia a animacao
            gate.classList.add('erro');
            msg.textContent = 'PIN incorreto.';
            campo.value = '';
            campo.focus();
          }
        });
      })();
    </script>
