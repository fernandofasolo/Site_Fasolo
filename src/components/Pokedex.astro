---
import { POKEMON, numeroDex } from '../data/pokedex/pokedex';
import { TIPOS_ORDENADOS, nomeTipo, corTipo } from '../data/pokedex/tipos';
import type { Treinador } from '../data/pokedex/treinadores';

interface Props {
  treinador: Treinador;
}

const { treinador } = Astro.props;
const { progresso, faltantes } = treinador;

/* Chave de busca sem acento, sem pontuacao e em minusculas, para que
   "mr mime", "Mr. Mime" e "mrmime" encontrem a mesma ficha. */
const chaveBusca = (nome: string) =>
  nome
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');

const pct = (n: number) => n.toFixed(1).replace('.', ',');

/* Circunferencia do anel de progresso (r = 52). */
const RAIO = 52;
const VOLTA = 2 * Math.PI * RAIO;
const preenchido = (progresso.percentual / 100) * VOLTA;

/* Só oferecemos no filtro os tipos que realmente aparecem na dex. */
const tiposPresentes = TIPOS_ORDENADOS.filter((t) => POKEMON.some((p) => p.types.includes(t)));
---

<section class="pokedex" style={`--acc:${treinador.cor}; --acc-rgb:${treinador.corRgb}`}>

  <!-- ============ PLACAR ============ -->
  <div class="placar">
    <div class="anel-wrap">
      <svg class="anel" viewBox="0 0 120 120" role="img" aria-label={`${pct(progresso.percentual)}% da Pokédex completa`}>
        <circle cx="60" cy="60" r={RAIO} class="anel-trilha" />
        <circle
          cx="60" cy="60" r={RAIO}
          class="anel-barra"
          stroke-dasharray={`${preenchido} ${VOLTA}`}
        />
      </svg>
      <div class="anel-texto">
        <strong>{pct(progresso.percentual)}<span>%</span></strong>
        <span class="anel-legenda">completa</span>
      </div>
    </div>

    <div class="placar-numeros">
      <div class="bloco">
        <span class="bloco-valor">{progresso.capturados.toLocaleString('pt-BR')}</span>
        <span class="bloco-rotulo">capturados</span>
      </div>
      <div class="bloco">
        <span class="bloco-valor faltando">{progresso.faltam.toLocaleString('pt-BR')}</span>
        <span class="bloco-rotulo">faltando</span>
      </div>
      <div class="bloco">
        <span class="bloco-valor discreto">{progresso.total.toLocaleString('pt-BR')}</span>
        <span class="bloco-rotulo">na Pokédex Nacional</span>
      </div>
    </div>
  </div>

  <!-- ============ PROGRESSO POR GERAÇÃO ============ -->
  <div class="geracoes">
    {progresso.geracoes.map((g) => (
      <button class="ger" data-ger={g.num} type="button" aria-pressed="false">
        <div class="ger-topo">
          <span class="ger-nome">Gen {g.num} · {g.regiao}</span>
          <span class="ger-conta">{g.capturados}/{g.total}</span>
        </div>
        <div class="ger-trilha">
          <div class="ger-barra" style={`width:${g.percentual}%`}></div>
        </div>
        <span class="ger-jogos">{g.completa ? '✓ completa' : `faltam ${g.faltam}`}</span>
      </button>
    ))}
  </div>

  <!-- ============ CONTROLES ============ -->
  <div class="controles">
    <div class="modos" role="group" aria-label="Filtrar por situação">
      <button type="button" class="modo ativo" data-modo="todos">Todos</button>
      <button type="button" class="modo" data-modo="capturados">Capturados</button>
      <button type="button" class="modo" data-modo="faltando">Só o que falta</button>
    </div>

    <div class="campos">
      <label class="campo busca">
        <span class="sr">Buscar Pokémon</span>
        <input type="search" id="pkdx-busca" placeholder="Buscar por nome ou número…" autocomplete="off" />
      </label>

      <label class="campo">
        <span class="sr">Filtrar por tipo</span>
        <select id="pkdx-tipo">
          <option value="">Todos os tipos</option>
          {tiposPresentes.map((t) => <option value={t}>{nomeTipo(t)}</option>)}
        </select>
      </label>

      <button type="button" id="pkdx-limpar" class="limpar">Limpar</button>
    </div>
  </div>

  <p class="resumo" id="pkdx-resumo" aria-live="polite"></p>

  <!-- ============ GRADE ============ -->
  <ul class="grade" id="pkdx-grade">
    {POKEMON.map((p) => {
      const falta = faltantes.has(p.id);
      return (
        <li
          class:list={['cel', { falta }]}
          id={`pkmn-${p.id}`}
          data-id={p.id}
          data-nome={chaveBusca(p.name)}
          data-ger={p.gen}
          data-tipos={p.types.join(' ')}
          data-falta={falta ? '1' : '0'}
          title={falta ? `#${numeroDex(p.id)} ${p.name} — ainda não capturado` : `#${numeroDex(p.id)} ${p.name}`}
        >
          <span class="num">{numeroDex(p.id)}</span>
          <span class="arte">
            <img
              src={`/pokedex/sprites/${p.id}.webp`}
              alt={p.name}
              width="128"
              height="128"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="nome">{p.name}</span>
          <span class="tipos">
            {p.types.map((t) => (
              <i class="pip" style={`--c:${corTipo(t)}`} title={nomeTipo(t)}></i>
            ))}
          </span>
        </li>
      );
    })}
  </ul>

  <p class="vazio" id="pkdx-vazio" hidden>Nenhum Pokémon com esses filtros.</p>

  <!-- ============ LISTA DOS QUE FALTAM ============ -->
  <div class="pendentes">
    <h3>Lista de caça</h3>
    {progresso.completa ? (
      <p class="completa">
        🏆 Pokédex Nacional completa — todos os {progresso.total.toLocaleString('pt-BR')} registrados.
      </p>
    ) : (
      <>
        <p class="pendentes-intro">
          Os {progresso.faltam.toLocaleString('pt-BR')} números que ainda faltam.
          É exatamente esta lista que vive no arquivo <code>faltantes-{treinador.slug}.ts</code>:
          capturou um, apaga o número de lá e a barra sobe sozinha.
        </p>
        {/* O {' '} depois do separador nao e decorativo: sem espaco entre as
            tags inline o navegador nao acha onde quebrar a linha, e as centenas
            de numeros viram uma linha unica que rola a pagina de lado (o mesmo
            engano do commit b2e8a23). O espaco vai so DEPOIS do "·" — assim ele
            fica colado no numero anterior e nunca sobra sozinho abrindo linha. */}
        <p class="pendentes-lista">
          {progresso.faltantesOrdenados.map((id, i) => (
            <>
              {i > 0 && <><span class="sep">·</span>{' '}</>}
              <a href={`#pkmn-${id}`} class="pend" data-ir={id}>{numeroDex(id)}</a>
            </>
          ))}
        </p>
        <button type="button" id="pkdx-copiar" class="copiar">Copiar os números que faltam</button>
      </>
    )}
  </div>
</section>

<style>
  .pokedex { --borda: rgba(255,255,255,.07); }

  .sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* ---------- placar ---------- */
  .placar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 2rem;
    background: rgba(15,15,25,.7);
    border: 1px solid var(--borda);
    border-radius: 1.25rem;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }
  .anel-wrap { position: relative; width: 132px; height: 132px; flex-shrink: 0; }
  .anel { width: 100%; height: 100%; transform: rotate(-90deg); }
  .anel-trilha { fill: none; stroke: rgba(255,255,255,.08); stroke-width: 9; }
  .anel-barra {
    fill: none; stroke: var(--acc); stroke-width: 9; stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgb(var(--acc-rgb) / .55));
  }
  .anel-texto {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    line-height: 1;
  }
  .anel-texto strong {
    font-family: 'Sora', sans-serif; font-size: 1.6rem; font-weight: 800; color: #fff;
  }
  .anel-texto strong span { font-size: .9rem; color: var(--acc); margin-left: 1px; }
  .anel-legenda { font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; color: #64748b; margin-top: .35rem; }

  .placar-numeros { display: flex; flex-wrap: wrap; gap: 2rem; }
  .bloco { display: flex; flex-direction: column; }
  .bloco-valor {
    font-family: 'Sora', sans-serif; font-size: 2rem; font-weight: 800; color: var(--acc); line-height: 1.1;
  }
  .bloco-valor.faltando { color: #f1f5f9; }
  .bloco-valor.discreto { color: #475569; }
  .bloco-rotulo { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: #64748b; margin-top: .3rem; }

  /* ---------- geracoes ---------- */
  .geracoes {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: .75rem; margin-bottom: 1.75rem;
  }
  .ger {
    text-align: left; background: rgba(15,15,25,.55);
    border: 1px solid var(--borda); border-radius: .8rem;
    padding: .7rem .85rem; cursor: pointer;
    transition: border-color .2s, transform .2s, background .2s;
    font: inherit; color: inherit;
  }
  .ger:hover { border-color: rgb(var(--acc-rgb) / .45); transform: translateY(-2px); }
  .ger[aria-pressed='true'] { border-color: var(--acc); background: rgb(var(--acc-rgb) / .1); }
  .ger-topo { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: .45rem; }
  .ger-nome { font-size: .78rem; font-weight: 700; color: #e2e8f0; }
  .ger-conta { font-size: .7rem; color: #64748b; font-variant-numeric: tabular-nums; }
  .ger-trilha { height: 5px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
  .ger-barra { height: 100%; background: var(--acc); border-radius: 99px; }
  .ger-jogos { display: block; font-size: .65rem; color: #64748b; margin-top: .4rem; }

  /* ---------- controles ---------- */
  .controles {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;
    margin-bottom: 1rem;
  }
  .modos { display: flex; gap: .35rem; background: rgba(15,15,25,.7); border: 1px solid var(--borda); border-radius: 99px; padding: .25rem; }
  .modo {
    border: 0; background: transparent; color: #94a3b8; cursor: pointer;
    padding: .4rem .95rem; border-radius: 99px; font-size: .8rem; font-weight: 600;
    transition: background .2s, color .2s; font-family: inherit;
  }
  .modo:hover { color: #e2e8f0; }
  .modo.ativo { background: var(--acc); color: #100c0d; }

  .campos { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .campo { display: block; }
  .campos input, .campos select {
    background: rgba(15,15,25,.7); border: 1px solid var(--borda); border-radius: .6rem;
    color: #e2e8f0; padding: .5rem .8rem; font-size: .85rem; font-family: inherit;
    outline: none; transition: border-color .2s;
  }
  .campos input { min-width: 220px; }
  .campos input:focus, .campos select:focus { border-color: var(--acc); }
  .campos input::placeholder { color: #64748b; }
  .campos select option { background: #100c0d; }
  .limpar {
    background: transparent; border: 1px solid var(--borda); border-radius: .6rem;
    color: #94a3b8; padding: .5rem .8rem; font-size: .85rem; cursor: pointer; font-family: inherit;
    transition: color .2s, border-color .2s;
  }
  .limpar:hover { color: #e2e8f0; border-color: var(--acc); }

  .resumo { font-size: .8rem; color: #64748b; margin: 0 0 1rem; min-height: 1.2em; }

  /* ---------- grade ---------- */
  .grade {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: .6rem;
  }
  .cel {
    position: relative; display: flex; flex-direction: column; align-items: center;
    background: rgba(15,15,25,.6);
    border: 1px solid var(--borda); border-radius: .85rem;
    padding: .5rem .35rem .6rem;
    transition: border-color .2s, transform .2s, background .2s;
    scroll-margin-top: 7rem;
  }
  .cel:hover { border-color: var(--acc); transform: translateY(-3px); background: rgba(20,20,32,.85); }
  .cel.oculto { display: none; }
  .num {
    font-size: .62rem; font-variant-numeric: tabular-nums; letter-spacing: .06em;
    color: #475569; align-self: flex-start; padding-left: .2rem;
  }
  .arte { display: block; width: 100%; }
  .cel img { display: block; width: 72px; height: 72px; margin: 0 auto; object-fit: contain; }
  .nome {
    font-size: .72rem; font-weight: 600; color: #cbd5e1; text-align: center;
    margin-top: .25rem; line-height: 1.2; overflow-wrap: anywhere;
  }
  .tipos { display: flex; gap: 3px; margin-top: .35rem; }
  .pip { width: 14px; height: 4px; border-radius: 99px; background: var(--c); display: block; }

  /* nao capturado: a arte continua visivel, so que com a cor lavada —
     da para reconhecer quem e sem confundir com quem ja foi registrado */
  .cel.falta { background: rgba(10,10,16,.75); border-style: dashed; border-color: rgba(255,255,255,.1); }
  .cel.falta img { filter: saturate(.25); opacity: .45; }
  .cel.falta .nome { color: #475569; }
  .cel.falta .pip { opacity: .25; }
  .cel.falta::after {
    content: '?'; position: absolute; top: .3rem; right: .45rem;
    font-family: 'Sora', sans-serif; font-size: .7rem; font-weight: 800; color: #475569;
  }
  .cel.falta:hover { border-color: var(--acc); border-style: solid; }
  .cel.destaque { border-color: var(--acc); box-shadow: 0 0 0 2px rgb(var(--acc-rgb) / .35); }

  .vazio { text-align: center; color: #64748b; padding: 3rem 0; }

  /* ---------- pendentes ---------- */
  .pendentes {
    margin-top: 2.5rem; padding: 1.5rem;
    background: rgba(15,15,25,.6); border: 1px solid var(--borda); border-radius: 1.25rem;
  }
  .pendentes h3 {
    font-family: 'Sora', sans-serif; font-size: 1.05rem; color: #f1f5f9; margin: 0 0 .75rem;
  }
  .pendentes-intro { font-size: .85rem; color: #94a3b8; margin: 0 0 1rem; line-height: 1.7; }
  .pendentes-intro code { background: rgb(var(--acc-rgb) / .14); color: var(--acc); padding: 1px 6px; border-radius: 4px; font-size: .9em; }
  /* overflow-wrap segura o caso de o espaco entre os numeros sumir de novo:
     mesmo sem ponto de quebra natural a linha passa a poder quebrar. */
  .pendentes-lista { margin: 0 0 1rem; line-height: 2.1; overflow-wrap: anywhere; }
  .pend {
    font-variant-numeric: tabular-nums; font-size: .8rem; color: #94a3b8;
    text-decoration: none; padding: 2px 5px; border-radius: 4px; transition: background .15s, color .15s;
  }
  .pend:hover { background: var(--acc); color: #100c0d; }
  .sep { color: #334155; margin: 0 1px; }
  .copiar {
    background: transparent; border: 1px solid var(--acc); color: var(--acc);
    border-radius: .6rem; padding: .5rem .9rem; font-size: .8rem; font-weight: 600;
    cursor: pointer; font-family: inherit; transition: background .2s, color .2s;
  }
  .copiar:hover { background: var(--acc); color: #100c0d; }
  .completa { color: #cbd5e1; font-size: .95rem; margin: 0; }

  @media (max-width: 640px) {
    .placar { gap: 1.25rem; padding: 1.25rem; }
    .placar-numeros { gap: 1.25rem; }
    .bloco-valor { font-size: 1.5rem; }
    .grade { grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: .45rem; }
    .cel img { width: 60px; height: 60px; }
    .campos input { min-width: 0; flex: 1; }
    .campos { width: 100%; }
  }
</style>

<script>
  function iniciarPokedex(raiz: HTMLElement) {
    const grade = raiz.querySelector<HTMLElement>('#pkdx-grade');
    const celulas = Array.from(raiz.querySelectorAll<HTMLElement>('.cel'));
    const busca = raiz.querySelector<HTMLInputElement>('#pkdx-busca');
    const seletorTipo = raiz.querySelector<HTMLSelectElement>('#pkdx-tipo');
    const resumo = raiz.querySelector<HTMLElement>('#pkdx-resumo');
    const vazio = raiz.querySelector<HTMLElement>('#pkdx-vazio');
    const botoesModo = Array.from(raiz.querySelectorAll<HTMLElement>('.modo'));
    const botoesGer = Array.from(raiz.querySelectorAll<HTMLElement>('.ger'));
    const limpar = raiz.querySelector<HTMLElement>('#pkdx-limpar');
    const copiar = raiz.querySelector<HTMLElement>('#pkdx-copiar');

    if (!grade || !celulas.length) return;

    const estado = { modo: 'todos', termo: '', tipo: '', geracao: 0 };

    const normalizar = (texto: string) =>
      texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');

    function aplicar() {
      let visiveis = 0;
      let faltandoVisiveis = 0;

      for (const cel of celulas) {
        const falta = cel.dataset.falta === '1';

        let ok = true;
        if (estado.modo === 'faltando' && !falta) ok = false;
        if (estado.modo === 'capturados' && falta) ok = false;
        if (ok && estado.geracao && Number(cel.dataset.ger) !== estado.geracao) ok = false;
        if (ok && estado.tipo && !(cel.dataset.tipos ?? '').split(' ').includes(estado.tipo)) ok = false;
        if (ok && estado.termo) {
          const porNome = (cel.dataset.nome ?? '').includes(estado.termo);
          const porNumero = /^\d+$/.test(estado.termo) && String(cel.dataset.id) === String(Number(estado.termo));
          if (!porNome && !porNumero) ok = false;
        }

        cel.classList.toggle('oculto', !ok);
        if (ok) {
          visiveis++;
          if (falta) faltandoVisiveis++;
        }
      }

      if (vazio) vazio.hidden = visiveis > 0;

      if (resumo) {
        if (visiveis === celulas.length) {
          resumo.textContent = `Mostrando os ${celulas.length.toLocaleString('pt-BR')} Pokémon da Pokédex Nacional.`;
        } else {
          const capturadosVisiveis = visiveis - faltandoVisiveis;
          resumo.textContent =
            `${visiveis.toLocaleString('pt-BR')} em exibição — ` +
            `${capturadosVisiveis.toLocaleString('pt-BR')} capturados, ` +
            `${faltandoVisiveis.toLocaleString('pt-BR')} faltando.`;
        }
      }
    }

    botoesModo.forEach((b) =>
      b.addEventListener('click', () => {
        botoesModo.forEach((o) => o.classList.toggle('ativo', o === b));
        estado.modo = b.dataset.modo ?? 'todos';
        aplicar();
      }),
    );

    botoesGer.forEach((b) =>
      b.addEventListener('click', () => {
        const num = Number(b.dataset.ger);
        const jaAtivo = estado.geracao === num;
        estado.geracao = jaAtivo ? 0 : num;
        botoesGer.forEach((o) =>
          o.setAttribute('aria-pressed', String(!jaAtivo && o === b)),
        );
        aplicar();
      }),
    );

    let debounce: number | undefined;
    busca?.addEventListener('input', () => {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        estado.termo = normalizar(busca.value.trim());
        aplicar();
      }, 120);
    });

    seletorTipo?.addEventListener('change', () => {
      estado.tipo = seletorTipo.value;
      aplicar();
    });

    limpar?.addEventListener('click', () => {
      estado.modo = 'todos';
      estado.termo = '';
      estado.tipo = '';
      estado.geracao = 0;
      if (busca) busca.value = '';
      if (seletorTipo) seletorTipo.value = '';
      botoesModo.forEach((o) => o.classList.toggle('ativo', o.dataset.modo === 'todos'));
      botoesGer.forEach((o) => o.setAttribute('aria-pressed', 'false'));
      aplicar();
    });

    /* Clicar num numero da lista de caca rola ate a ficha e a destaca. */
    raiz.querySelectorAll<HTMLElement>('.pend').forEach((link) =>
      link.addEventListener('click', (ev) => {
        ev.preventDefault();
        const alvo = celulas.find((c) => c.dataset.id === link.dataset.ir);
        if (!alvo) return;
        if (alvo.classList.contains('oculto')) {
          limpar?.dispatchEvent(new Event('click'));
        }
        alvo.scrollIntoView({ behavior: 'smooth', block: 'center' });
        alvo.classList.add('destaque');
        window.setTimeout(() => alvo.classList.remove('destaque'), 2000);
      }),
    );

    copiar?.addEventListener('click', async () => {
      const numeros = celulas
        .filter((c) => c.dataset.falta === '1')
        .map((c) => c.dataset.id)
        .join(', ');
      const rotuloOriginal = copiar.textContent;
      try {
        await navigator.clipboard.writeText(numeros);
        copiar.textContent = '✓ Copiado!';
      } catch {
        copiar.textContent = 'Não foi possível copiar';
      }
      window.setTimeout(() => {
        copiar.textContent = rotuloOriginal;
      }, 1800);
    });

    aplicar();
  }

  document.querySelectorAll<HTMLElement>('.pokedex').forEach(iniciarPokedex);
</script>
