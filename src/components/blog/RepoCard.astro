---
// Cartão de repositório do GitHub com chamada para o código e para a última versão.
interface Props {
  repo: string; // "dono/nome"
  descricao: string;
  tags?: string[];
  versao?: string;
}

const { repo, descricao, tags = [], versao } = Astro.props;
const url = `https://github.com/${repo}`;
---

<div class="not-prose my-10 rounded-2xl border border-amber-400/30 bg-gradient-to-br from-amber-950/40 via-[#100c0d] to-green-950/30 p-6">
  <div class="flex items-center gap-3">
    <svg viewBox="0 0 16 16" class="h-7 w-7 fill-white" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>
    <a href={url} class="text-lg font-bold text-white hover:text-amber-300" style="font-family:'Sora', sans-serif;">{repo}</a>
    {versao && <span class="ml-auto rounded-full bg-green-900/50 px-3 py-0.5 text-xs font-bold text-green-300">{versao}</span>}
  </div>
  <p class="mt-3 text-slate-300">{descricao}</p>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {tags.map((t) => <span class="rounded-full border border-white/10 px-2.5 py-0.5 text-xs text-slate-400">{t}</span>)}
    </div>
  )}
  <div class="mt-5 flex flex-wrap gap-3">
    <a href={url} class="rounded-xl bg-amber-400 px-4 py-2 text-sm font-bold text-[#100c0d] hover:bg-amber-300">Ver o código</a>
    {versao && (
      <a href={`${url}/releases/tag/${versao}`} class="rounded-xl border border-white/15 px-4 py-2 text-sm font-bold text-white hover:border-amber-400/60">
        Baixar a {versao}
      </a>
    )}
  </div>
</div>
