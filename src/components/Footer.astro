---
import { Image } from 'astro:assets';
import logoVidro from '../assets/logo/fasolo-glass.png';
---
<footer class="border-t border-slate-800/60 py-8 text-center text-slate-600 text-sm">
  <a href="/" class="inline-block mb-2" aria-label="[FASOLO] — página inicial">
    <Image src={logoVidro} alt="[FASOLO]" widths={[240, 360]} sizes="130px" format="webp" quality={82}
      class="block h-11 w-auto opacity-90 hover:opacity-100 transition-opacity" />
  </a>
  <p>© {new Date().getFullYear()} Fernando Fasolo & Fernando Fasolo Filho — fasolo.ia.br</p>
</footer>
